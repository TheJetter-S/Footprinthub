# =============================================================================
# FootprintHub Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=footprinthub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=footprinthub
DATABASE_URL=postgresql+asyncpg://footprinthub:changeme@postgres:5432/footprinthub

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Keys (all optional — features degrade gracefully without them) ──────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
HUNTER_IO_API_KEY=
HIBP_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
GITHUB_TOKEN=

# ── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ── Scan Defaults ───────────────────────────────────────────────────────────
DEFAULT_MODULE_TIMEOUT=60
MAX_RESPONSE_SIZE_BYTES=10485760
CACHE_TTL_SECONDS=86400

# ── Application ─────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_ENV=development
